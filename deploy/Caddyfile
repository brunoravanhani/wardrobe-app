# SITE_ADDRESS is injected from the environment (e.g. <static-ip>.sslip.io).
# Caddy obtains and renews a Let's Encrypt certificate for it automatically.
{$SITE_ADDRESS} {
	encode gzip

	# API: proxy everything under /api to the backend container.
	handle /api/* {
		reverse_proxy api:8080
	}

	# SPA: serve the static build and fall back to index.html for client routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
