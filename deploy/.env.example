# Copy to deploy/.env on the instance (never commit the real .env).
# The deploy workflow rewrites this file from GitHub Actions Secrets.

# ---- Image selection (compose interpolation) ----
GHCR_OWNER=your-github-owner
IMAGE_TAG=latest
SITE_ADDRESS=<static-ip>.sslip.io

# ---- ASP.NET ----
ASPNETCORE_ENVIRONMENT=Production
RunMigrationsOnStartup=true

# ---- Database (Lightsail managed PostgreSQL, private endpoint, TLS) ----
ConnectionStrings__Default=Host=<db-endpoint>;Port=5432;Database=<db-name>;Username=<db-user>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# ---- JWT ----
Jwt__Issuer=virtual-wardrobe-api
Jwt__Audience=virtual-wardrobe-web
Jwt__SigningKey=<32-plus-character-signing-key>
Jwt__AccessTokenMinutes=1440

# ---- Google OAuth ----
Auth__Google__ClientId=<google-client-id>
Auth__Google__ClientSecret=<google-client-secret>

# ---- AWS S3 (presign-only IAM user) ----
AWS__Region=us-east-1
AWS__S3__BucketName=<bucket-name>
AWS__AccessKeyId=<iam-access-key-id>
AWS__SecretAccessKey=<iam-secret-access-key>
AWS__S3__UploadUrlExpirationMinutes=10
AWS__S3__ViewUrlExpirationMinutes=5

# ---- CORS (same-origin behind Caddy; belt-and-suspenders) ----
Cors__AllowedOrigins__0=https://<static-ip>.sslip.io

# ---- Frontend build-time (non-secret; baked into the web image) ----
VITE_GOOGLE_CLIENT_ID=<google-client-id>
