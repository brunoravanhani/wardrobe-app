  {
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=virtual_wardrobe;Username=<db-user>;Password=<db-password>"
  },
  "Auth": {
    "Google": {
      "ClientId": "<google-client-id>",
      "ClientSecret": "<google-client-secret>"
    }
  },
  "Jwt": {
    "Issuer": "virtual-wardrobe-api",
    "Audience": "virtual-wardrobe-web",
    "SigningKey": "<jwt-signing-key-min-32-chars>",
    "AccessTokenMinutes": 30
  },
  "AWS": {
    "Region": "<aws-region>",
    "AccessKeyId": "<aws-access-key-id>",
    "SecretAccessKey": "<aws-secret-access-key>",
    "S3": {
      "BucketName": "<private-bucket-name>",
      "UploadUrlExpirationMinutes": 10,
      "ViewUrlExpirationMinutes": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
